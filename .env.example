export HF_TOKEN=your_huggingface_token

# Number of FineWeb documents to feed
export NUM_DOCS=100000

# Which Vespa to use: local (Docker) or cloud (Vespa Cloud)
export VESPA_MODE=local

# local mode
export VESPA_LOCAL_URL=http://localhost
export VESPA_LOCAL_PORT=8080
export VESPA_CONTAINER_MEMORY_GB=8

# cloud mode
export VESPA_CLOUD_ENDPOINT=https://<your-app>.vespa-app.cloud/
export VESPA_CERT_DIR=~/.vespa/<tenant>.<app>.default

# Docker Desktop socket (the Python Docker client defaults to /var/run/docker.sock, which Docker Desktop doesn't create)
export DOCKER_HOST=unix:///Users/<you>/.docker/run/docker.sock
